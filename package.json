{
  "name": "br-tours-and-travels-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.4",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "vercel-build": "npm run db:prepare:deploy && npm run build",
    "start": "node dist/server.js",
    "lint": "eslint src scripts prisma --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed:demo": "tsx prisma/seed.ts",
    "db:seed:demo:if-enabled": "tsx scripts/seed-demo-if-enabled.ts",
    "db:prepare:deploy": "prisma generate && npm run db:migrate:deploy && npm run db:seed:demo:if-enabled",
    "admin:create": "tsx scripts/create-admin.ts",
    "notifications:work": "tsx src/worker.ts",
    "env:check": "tsx scripts/check-env.ts",
    "postinstall": "prisma generate",
    "prestart": "npm run db:prepare:deploy"
  },
  "dependencies": {
    "@prisma/adapter-mariadb": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "cors": "2.8.6",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "file-type": "22.0.2",
    "helmet": "8.3.0",
    "mariadb": "3.5.3",
    "multer": "2.3.0",
    "nodemailer": "9.0.6",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "sanitize-html": "2.17.0",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@inquirer/prompts": "8.7.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/multer": "2.2.0",
    "@types/node": "26.4.0",
    "@types/nodemailer": "8.0.1",
    "@types/sanitize-html": "2.16.1",
    "eslint": "9.39.5",
    "globals": "16.4.0",
    "prisma": "7.10.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0"
  },
  "overrides": {
    "mariadb": "3.5.3"
  }
}
